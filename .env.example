# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Neon (Postgres) ---
# Both provided by the Neon dashboard for the same database.
DATABASE_URL=                # pooled — used by app code (getDb())
DATABASE_URL_UNPOOLED=       # direct — used only by drizzle-kit migrations

# --- Better Auth ---
BETTER_AUTH_SECRET=          # 32+ random chars, e.g. `openssl rand -base64 32`
BETTER_AUTH_URL=             # e.g. https://falcotrix.vercel.app (no trailing slash)
NEXT_PUBLIC_BETTER_AUTH_URL= # same value as BETTER_AUTH_URL, exposed to the client

# --- Cloudinary (Media Library) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (invite emails, password resets, contact notifications) ---
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=        # where new /contact submissions are emailed to
